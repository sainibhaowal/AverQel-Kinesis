{
  "name": "averqel-harness-desktop",
  "private": true,
  "version": "0.1.6",
  "description": "Native DeepSpace workspace for building and running agents",
  "homepage": "https://averqel.com",
  "desktopName": "AverQel Kinesis",
  "author": {
    "name": "AverQel",
    "email": "support@averqel.com",
    "url": "https://averqel.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "prepare:brand-assets": "node scripts/prepare-brand-assets.mjs",
    "prepare:frontend": "node scripts/prepare-frontend.mjs",
    "build": "pnpm run prepare:frontend && pnpm run prepare:brand-assets && electron-builder --publish never",
    "build:linux": "pnpm run prepare:frontend && pnpm run prepare:brand-assets && electron-builder --publish never --linux deb",
    "build:windows": "pnpm run prepare:frontend && pnpm run prepare:brand-assets && electron-builder --publish never --win nsis",
    "build:mac": "pnpm run prepare:frontend && pnpm run prepare:brand-assets && electron-builder --publish never --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.averqel.harness",
    "productName": "AverQel Kinesis",
    "asar": true,
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/out",
        "to": "frontend"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "linux": {
      "category": "Office",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "synopsis": "Native DeepSpace workspace for building and running agents",
      "description": "Build, configure, and run DeepSpace agents with local tools, providers, and workspace files.",
      "desktop": {
        "entry": {
          "Name": "AverQel Kinesis"
        }
      },
      "target": [
        "deb"
      ]
    },
    "deb": {
      "fpm": [
        "assets/com.averqel.harness.metainfo.xml=/usr/share/metainfo/com.averqel.harness.metainfo.xml"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "AverQel Kinesis"
    },
    "publish": null
  }
}
